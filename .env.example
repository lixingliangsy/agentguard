# Copy to .env.local (gitignored). Do NOT commit real keys.

# --- OpenAI (Studio LLM; optional — without it, mock mode) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Waffo Pancake (checkout) ---
# Copy MERCHANT_ID / PRIVATE_KEY from E:\AgentCPM\_keys.env (shared merchant).
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_BASE_URL=https://api.waffo.ai
# Optional storefront base (never hardcode cs_* session links — they expire ~45min)
# WAFFO_STORE_URL=https://pancake.waffo.ai/store/lixingliang-ai-tools-6cilbw8v

# Product IDs live in lib/product.ts (committed):
